{
  "expo": {
    "name": "CaloDone",
    "slug": "calodone",
    "scheme": "calodone",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.calodone.pi-mobile-spike",
      "infoPlist": {
        "NSCameraUsageDescription": "CaloDone uses the camera to photograph meals without saving them to your gallery."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.calodone.pimobilespike",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "CaloDone uses the camera to photograph meals without saving them to your gallery.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      "expo-web-browser",
      "expo-sqlite",
      "expo-background-task"
    ]
  }
}
