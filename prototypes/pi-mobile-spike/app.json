{
  "expo": {
    "name": "CaloDone",
    "slug": "calodone",
    "scheme": "calodone",
    "version": "1.0.0",
    "backgroundColor": "#F3F0EA",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.calodone.pi-mobile-spike",
      "infoPlist": {
        "NSCameraUsageDescription": "CaloDone uses the camera to photograph meals without saving them to your gallery."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.calodone.pimobilespike",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#59677D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#FCFAF5",
      "barStyle": "dark-content",
      "enforceContrast": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "CaloDone uses the camera to photograph meals without saving them to your gallery.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CaloDone lets you choose existing meal photos for analysis."
        }
      ],
      "expo-notifications",
      "expo-web-browser",
      "expo-sqlite",
      "expo-background-task",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "CaloDone needs photo access only when you save or share a meal photo.",
          "savePhotosPermission": "CaloDone saves a meal photo only after you choose Save to device.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ]
  }
}
